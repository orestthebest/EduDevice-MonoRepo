# /etc/systemd/system/edudevice-api.service
[Unit]
Description=EduDevice REST-API (FastAPI)
After=network.target mysql.service
Wants=mysql.service

[Service]
User=student
WorkingDirectory=/home/student/edudevice-backend
EnvironmentFile=/home/student/edudevice-backend/api.env
ExecStart=/home/student/edudevice-backend/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
